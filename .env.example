# ================================================
# PoliticAI — Ortam Değişkenleri
# Gerçek değerleri .env dosyasına kopyalayarak doldur.
# .env dosyasını asla git'e commit etme!
# ================================================

# --- FRONTEND (Vite — VITE_ prefix zorunlu, tarayıcıda okunur) ---

# Local Supabase API URL — `npx supabase start` çıktısındaki "API URL"
VITE_SUPABASE_URL=

# Local Supabase anon key — `npx supabase start` çıktısındaki "anon key"
VITE_SUPABASE_ANON_KEY=

# n8n webhook base URL — Cloudflare Tunnel adresi (ör: https://xyz.trycloudflare.com)
# Local geliştirmede tunnel açıkken bu değeri gir
VITE_N8N_WEBHOOK_BASE_URL=


# --- n8n (n8n UI → Settings → Variables olarak tek tek girilir) ---

# Supabase URL — Docker network üzerinden (genellikle http://host.docker.internal:54321)
# n8n ve Supabase aynı Docker ortamındaysa bu adresi kullan
SUPABASE_URL=

# Supabase anon key — frontend ile aynı değer
SUPABASE_ANON_KEY=

# Supabase service role key — SADECE n8n'de kullanılır!
# Frontend'e, git'e veya client-side koda ASLA verilmez.
# `npx supabase start` çıktısındaki "service_role key"
SUPABASE_SERVICE_ROLE_KEY=

# AI sağlayıcı seçimi
# "gemini-flash" → v1, ücretsiz, mevcut credential
# "claude-sonnet" → v2, ücretli, geçiş sonrası
AI_PROVIDER=gemini-flash

# Twitter API katmanı
# "free"  → günde 17 tweet, v1 için yeterli
# "basic" → $100/ay, v2 için
TWITTER_TIER=free

# Twitter OAuth token'larını şifrelemek için pgcrypto anahtarı
# Üretmek için terminalde çalıştır: openssl rand -hex 32
ENCRYPTION_KEY=
