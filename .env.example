# ================================================
# PoliticAI — Ortam Değişkenleri
# Gerçek değerleri .env dosyasına kopyalayarak doldur.
# .env dosyasını asla git'e commit etme!
# ================================================

# --- FRONTEND (Vite — VITE_ prefix zorunlu, tarayıcıda okunur) ---

# n8n webhook base URL — Cloudflare Tunnel adresi (ör: https://xyz.trycloudflare.com)
VITE_N8N_WEBHOOK_BASE_URL=

# scripts/seed-client.sql çalıştırdıktan sonra dönen UUID buraya gelir
VITE_CLIENT_ID=


# --- n8n (n8n UI → Settings → Variables olarak tek tek girilir) ---

# Neon veritabanı bağlantı stringi
DATABASE_URL=

# Auth — giriş için email ve şifre (v1: tek kullanıcı)
AUTH_EMAIL=
AUTH_PASSWORD=

# JWT imzalama sırrı — terminalde üret: openssl rand -hex 32
JWT_SECRET=

# AI sağlayıcı seçimi
# "gemini-flash" → v1, ücretsiz   |   "claude-sonnet" → v2, ücretli
AI_PROVIDER=gemini-flash

# Twitter API katmanı
# "free" → günde 17 tweet   |   "basic" → $100/ay
TWITTER_TIER=free

# Twitter OAuth token şifreleme anahtarı — openssl rand -hex 32
ENCRYPTION_KEY=
