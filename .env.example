# Server only. Never prefix secrets with VITE_.
DATABASE_URL=
# Existing clients.id, or a newly generated UUID for a new database.
CLIENT_ID=
AUTH_EMAIL=
# Run npm run auth:hash; do not store the plaintext password.
AUTH_PASSWORD_HASH=
# Generate each independently: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CRON_SECRET=
# Optional canonical origin. Leave empty locally and on Vercel preview deployments.
APP_URL=

# Primary provider. Both key and exact model ID are required before generation.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional alternate provider; set AI_PROVIDER=claude to use it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Maximum generation attempts per Istanbul calendar day, including failed attempts.
AI_DAILY_JOB_LIMIT=10
