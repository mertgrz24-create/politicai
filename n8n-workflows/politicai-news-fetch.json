      "position": [660, 0],
      "id": "bb000001-news-0000-0000-000000000008",
      "name": "Tümünü Birleştir"
    },
    {
      "parameters": {
        "jsCode": "// feedUrl'den kaynak adını belirle, DB şemasına normalize et\nconst items = $input.all();\n\nfunction sourceName(feedUrl) {\n  if (!feedUrl) return 'Bilinmeyen';\n  if (feedUrl.includes('trthaber') || feedUrl.includes('trt')) return 'TRT Haber';\n  if (feedUrl.includes('ahaber')) return 'A Haber';\n  if (feedUrl.includes('yenisafak')) return 'Yeni Safak';\n  return 'Bilinmeyen';\n}\n\nfunction safeStr(v, max) {\n  if (v == null) return null;\n  return String(v).trim().substring(0, max ?? 2000);\n}\n\nreturn items.map(item => {\n  const d = item.json;\n  const pubRaw = d.pubDate ?? d.isoDate ?? d.date ?? null;\n  let publishedAt = null;\n  if (pubRaw) {\n    const ts = Date.parse(pubRaw);\n    if (!isNaN(ts)) publishedAt = new Date(ts).toISOString();\n  }\n\n  return {\n    json: {\n      source_name:  sourceName(d.feedUrl),\n      title:        safeStr(d.title, 500),\n      description:  safeStr(d.contentSnippet ?? d.content ?? d.summary, 2000),\n      link:         safeStr(d.link, 1000),\n      published_at: publishedAt\n    }\n  };\n}).filter(i => i.json.link && i.json.title);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0],
      "id": "bb000001-news-0000-0000-000000000009",
      "name": "Normalize"
    },
    {
      "parameters": {
        "jsCode": "// Her item için INSERT sorgusu oluştur (tek tırnak escape'li)\nconst esc = (s) => s == null ? 'NULL' : `'${String(s).replace(/'/g, \"''\")}'`;\n\nreturn $input.all().map(item => {\n  const d = item.json;\n  const sql = `INSERT INTO news_pool (source_name, title, description, link, published_at)\nVALUES (${esc(d.source_name)}, ${esc(d.title)}, ${esc(d.description)}, ${esc(d.link)}, ${d.published_at ? esc(d.published_at) + '::timestamptz' : 'NULL'})\nON CONFLICT (link) DO NOTHING;`;\n  return { json: { sql, link: d.link } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0],
      "id": "bb000001-news-0000-0000-000000000010",
      "name": "SQL Oluştur"
    },
